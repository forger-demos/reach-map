{
  "name": "reach-map",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "PORT=${PORT:-3103} bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "check": "bun run build:client && bun run typecheck && bun run test",
    "build:client": "bun scripts/build-client.ts",
    "build": "bun scripts/build.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "data:build": "bun src/shell/data-build-cli.ts"
  },
  "devDependencies": {
    "@types/bun": "1.1.14",
    "playwright": "1.48.2",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0"
  }
}
